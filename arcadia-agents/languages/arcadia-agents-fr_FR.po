msgid "Enter the Connection Key from your Arcadia Agents dashboard, then click \"Connect\"."
msgstr "Saisissez la clé de connexion fournie par votre tableau de bord Arcadia Agents, puis cliquez sur « Connecter »."

msgid "Connection Key"
msgstr "Clé de connexion"

